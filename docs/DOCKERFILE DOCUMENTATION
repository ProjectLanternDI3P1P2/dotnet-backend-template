.gitignore

# IDE
.vs
.vscode
.idea

# .NET build files
**/bin/
**/obj/
**/TestResults/

# Visual Studio
*.user
*.suo

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Documentation
README*
docs/

# Operating system
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
*.pfx
*.p12
*.key
